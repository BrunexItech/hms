# Copy to ".env" next to docker-compose.prod.yml. Only read by that compose
# file (for the postgres container and host port choices) — the app itself
# reads backend/.env.
DB_NAME=hms
DB_USER=hms
DB_PASSWORD=change-me-to-a-real-password

# Host-side ports (127.0.0.1 only). Change only if these are already taken —
# check with `docker ps` first.
BACKEND_PORT=8003
FRONTEND_PORT=3002
