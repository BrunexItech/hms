# Copy to ".env" in this same directory and fill in real values.
# Never commit the real .env — it's already in .gitignore.

APP_NAME=HMS
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

# In docker-compose these point at the "postgres" service by name.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hms
DB_USER=hms
DB_PASSWORD=change-me-to-a-real-password

# MUST be a long random value in production (`openssl rand -hex 32`).
SECRET_KEY=change-me-to-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TENANT_ACCESS_TOKEN_EXPIRE_MINUTES=60
TENANT_REFRESH_TOKEN_EXPIRE_HOURS=24
ACCESS_LINK_EXPIRE_MINUTES=10

# Platform super-admin — seeded by `python seed.py`. Change the password
# immediately after first login in production.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin

ALLOWED_ORIGINS=["http://localhost:3010"]

RATE_LIMIT_OTP_PER_HOUR=5

# Leave SMTP_USER/PASSWORD blank in development — tenant sign-in links print
# to the backend console instead of sending real email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=HMS

FRONTEND_URL=http://localhost:3010
